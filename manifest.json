{
  "manifest_version": 3,
  "name": "Sanctum: Private Manga Tracker",
  "key": "",
  "version": "1.0",
  "description": "Privacy-first manga history sync using your personal Google Drive.",
  "permissions": ["identity", "storage"],
  "host_permissions": [
    "https://*.asuracomic.net/*",
    "https://*.mangahere.cc/*",
    "https://*.mangadex.org/*",
    "https://www.googleapis.com/*",
    "https://mangaplus.shueisha.co.jp/*"
  ],
  "oauth2": {
    "client_id": "497261885556-4amuijub3q7q1aju157029prakjebahp.apps.googleusercontent.com",
    "scopes": ["https://www.googleapis.com/auth/drive.file"]
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.asuracomic.net/*",
        "https://*.mangahere.cc/*",
        "https://*.mangadex.org/*",
        "https://mangaplus.shueisha.co.jp/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html"
  }
}
